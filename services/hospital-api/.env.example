# Copy to .env and fill in. Never commit .env.

# --- Medplum (FHIR server) -------------------------------------------------
MEDPLUM_BASE_URL=http://localhost:8103/
# ClientApplication of the hospital project (Medplum app > Project > Clients)
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Medplum admin used only to invite new staff users (Administration > Users)
MEDPLUM_PROVISIONING_EMAIL=
MEDPLUM_PROVISIONING_PASSWORD=

# --- Sessions ---------------------------------------------------------------
# At least 32 random characters; required when NODE_ENV=production
AUTH_SESSION_SECRET=
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS (the ehr-web dev server)
WEB_ORIGIN=http://localhost:5173

# Hospital code users may sign in to in this rollout phase
# (HOSP-A by default; HOSP-01 for the dedicated UAT hospital)
ACTIVE_HOSPITAL_CODE=HOSP-A

# Development-only admin login (disabled when NODE_ENV=production).
# Defaults to admin/admin when unset; set your own locally.
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=

# --- PACS / imaging ---------------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_DICOMWEB_PATH=/dicom-web
# Leave empty when Orthanc runs locally without authentication
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
# Viewer opened by "View Images": Orthanc's built-in OHIF plugin
OHIF_VIEWER_URL=http://localhost:8042/ohif
