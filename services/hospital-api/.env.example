# Copy to .env and fill in. Never commit .env.

# --- Medplum (FHIR server) -------------------------------------------------
MEDPLUM_BASE_URL=http://localhost:8103/
# ClientApplication of the hospital project (Medplum app > Project > Clients)
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Medplum admin used only to invite new staff users (Administration > Users)
MEDPLUM_PROVISIONING_EMAIL=
MEDPLUM_PROVISIONING_PASSWORD=

# --- Sessions ---------------------------------------------------------------
# At least 32 random characters; required when NODE_ENV=production
AUTH_SESSION_SECRET=
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS (the ehr-web dev server)
WEB_ORIGIN=http://localhost:5173

# Per-account sign-in lockout: failures within the window before locking, and lock length.
# Counters are kept in Medplum, so they are shared by all API instances and survive restarts.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Hospitals open for sign-in during the rollout (comma-separated codes).
# The login screen lists exactly these. ACTIVE_HOSPITAL_CODE (one code) is
# still honoured when this is unset; the default is HOSP-A.
ENABLED_HOSPITAL_CODES=HOSP-A

# Development-only admin login. Off unless explicitly enabled, has no built-in
# credentials, and the API refuses to start if enabled with NODE_ENV=production.
AUTH_DEV_ADMIN_ENABLED=false
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=

# How often (seconds) each API instance reloads logged-out sessions from Medplum
AUTH_REVOCATION_REFRESH_SECONDS=60

# --- PACS / imaging ---------------------------------------------------------
ORTHANC_URL=http://localhost:8042
ORTHANC_DICOMWEB_PATH=/dicom-web
# Orthanc service account; must match ORTHANC__REGISTERED_USERS in
# infrastructure/orthanc/.env.orthanc (see README, "PACS")
ORTHANC_USERNAME=hospital-api
ORTHANC_PASSWORD=
# Viewer opened by "View Images": OHIF served through the API's
# session-checked, read-only proxy (browsers never get Orthanc credentials)
OHIF_VIEWER_URL=http://localhost:4000/ohif
