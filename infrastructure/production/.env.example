# Copy to .env next to docker-compose.yml. No secrets here: those go in
# ./secrets (run ./generate-secrets.sh).

# The address staff open in the browser; must match the TLS certificate.
EHR_HOSTNAME=ehr.hospital.local

# TLS: a certificate from hospital IT (recommended), placed in ./certs:
#   EHR_TLS=tls /certs/cert.pem /certs/key.pem
# or, until you have one, Caddy's internal CA (browsers must trust it):
EHR_TLS=tls internal

# Hospitals open for sign-in (comma-separated codes).
ENABLED_HOSPITAL_CODES=HOSP-A

# Medplum, as reached from the API container. A Medplum stack on this same
# server: http://host.docker.internal:8103/
MEDPLUM_BASE_URL=http://host.docker.internal:8103/
MEDPLUM_CLIENT_ID=
MEDPLUM_PROVISIONING_EMAIL=

# Published ports (defaults 80/443). DICOM for modalities: restrict by firewall.
# HTTP_PORT=80
# HTTPS_PORT=443
# ORTHANC_DICOM_BIND=4242
