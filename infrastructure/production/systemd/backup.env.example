# Copy to /etc/unitech-ehr/backup.env (root-owned, mode 600). Used by the
# backup, restore drill and health-check units. No passwords needed: the
# scripts use docker exec against the running containers.
BACKUP_DIR=/var/backups/unitech-ehr
RETENTION_DAYS=14
# Off-server copy of each finished set (strongly recommended):
# OFFSITE_CMD=rsync -a "$1" backup@nas.hospital.local:/srv/ehr-backups/
MEDPLUM_PG_CONTAINER=unitech-medplum-postgres-1
MEDPLUM_BINARY_VOLUME=unitech-medplum_binary-data
ORTHANC_CONTAINER=unitech-ehr-orthanc-1
ORTHANC_VOLUME=unitech-ehr_orthanc-db
EHR_URL=https://ehr.hospital.local
MAX_BACKUP_AGE_HOURS=26
MIN_FREE_GB=20
# ALERT_CMD=mail -s "UNITECH-EHR alert" it-team@hospital.local
