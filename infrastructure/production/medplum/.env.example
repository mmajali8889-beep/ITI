# Copy to .env next to docker-compose.yml. No secrets here (see ./secrets).

# Where administrators reach Medplum (through an SSH tunnel), e.g.
#   ssh -L 8103:127.0.0.1:8103 -L 3000:127.0.0.1:3000 admin@ehr-server
# Also written into the Medplum config by generate-secrets.sh.
MEDPLUM_ADMIN_URL=http://localhost:8103/

# Loopback bindings (keep them on 127.0.0.1).
# MEDPLUM_ADMIN_BIND=127.0.0.1:8103
# MEDPLUM_APP_BIND=127.0.0.1:3000
